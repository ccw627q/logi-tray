#pragma code_page(65001)


1 ICON "app.ico"

// Custom device manager. All captions are set at runtime (see tray_menu.cpp)
// so this template stays pure ASCII and is immune to codepage issues.
#include <windows.h>

200 DIALOGEX 0, 0, 232, 156
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION ""
FONT 9, "Microsoft YaHei UI", 400, 0, 0x86
BEGIN
    LTEXT           "", 206, 10, 8, 212, 10
    LISTBOX         201, 10, 22, 212, 50, WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "", 205, 10, 76, 58, 14
    LTEXT           "", 207, 10, 98, 42, 10
    EDITTEXT        202, 56, 96, 166, 13, ES_AUTOHSCROLL
    LTEXT           "", 208, 10, 116, 42, 10
    EDITTEXT        203, 56, 114, 166, 13, ES_AUTOHSCROLL
    DEFPUSHBUTTON   "", 204, 124, 136, 46, 15
    PUSHBUTTON      "", 2, 176, 136, 46, 15
END

1 VERSIONINFO
FILEVERSION 1,2,3,0
PRODUCTVERSION 1,2,3,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "Iris"
            VALUE "FileDescription", "logi-tray"
            VALUE "FileVersion", "1.2.3.0"
            VALUE "InternalName", "logi-tray"
            VALUE "LegalCopyright", "Copyright (C) 2026 Iris"
            VALUE "OriginalFilename", "logi-tray.exe"
            VALUE "ProductName", "logi-tray"
            VALUE "ProductVersion", "1.2.3.0"
        END
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Iris"
            VALUE "FileDescription", "logi-tray"
            VALUE "FileVersion", "1.2.3.0"
            VALUE "InternalName", "logi-tray"
            VALUE "LegalCopyright", "Copyright (C) 2026 Iris"
            VALUE "OriginalFilename", "logi-tray.exe"
            VALUE "ProductName", "logi-tray"
            VALUE "ProductVersion", "1.2.3.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200, 0x0409, 1200
    END
END
